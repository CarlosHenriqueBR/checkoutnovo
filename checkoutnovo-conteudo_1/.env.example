# ---------------------------------------------------------------
# Vega Checkout — variáveis de ambiente
# Copie para .env.local e preencha.
# ---------------------------------------------------------------

# URL pública da aplicação (usada em webhooks, redirects e QR)
NEXT_PUBLIC_APP_URL=https://checkout-production-cdb6.up.railway.app

# Senha do dashboard (login em /login)
DASHBOARD_PASSWORD=troque-esta-senha

# Segredo para assinar o cookie de sessão do dashboard (string longa e aleatória)
SESSION_SECRET=troque-por-uma-string-longa-e-aleatoria

# Segredo do webhook: a Duttyfy chamará /api/webhooks/duttyfy?s=ESTE_VALOR
WEBHOOK_SECRET=troque-por-outro-valor-aleatorio

# Caminho do arquivo SQLite (local). Padrão: ./data/vega.db
DATABASE_FILE=./data/vega.db

# Pasta local de upload de imagens. Padrão: ./public/uploads
UPLOAD_DIR=./public/uploads

# Modo simulação do gateway: 1 = não chama a Duttyfy de verdade (para testes)
GATEWAY_MOCK=0
